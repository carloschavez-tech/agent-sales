//@version=5
// Agente de trading — misma lógica que `python -m agent_trading senal`.
// Úsalo en gráfico de 15 minutos (BTCUSDT.P, ETHUSDT.P o SOLUSDT.P de Binance).
// Tendencia 1h (solo horas CERRADAS, no repinta) + retroceso a EMA20 + stop por ATR, TP1 = 1R, TP2 = 2R.
indicator("Agente de trading — señales", overlay = true, max_labels_count = 200, max_lines_count = 400)

capital     = input.float(1000, "Capital (USD)")
riesgoPct   = input.float(1.0, "Riesgo por operación (%)", step = 0.1)
maxLev      = input.float(3, "Apalancamiento máximo")
comisionPct = input.float(0.05, "Comisión por lado (%)", step = 0.01)

// ── Tendencia en 1h, solo con la última hora cerrada ─────────
[hC, h50, h200] = request.security(syminfo.tickerid, "60",
     [close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1]], lookahead = barmerge.lookahead_on)
tendLong  = hC > h50 and h50 > h200
tendShort = hC < h50 and h50 < h200

// ── Gatillo en 15m ───────────────────────────────────────────
e20  = ta.ema(close, 20)
r    = ta.rsi(close, 14)
a    = ta.atr(14)
volOk = a / close >= 0.001 and a / close <= 0.02

longSig = barstate.isconfirmed and tendLong and volOk and ta.lowest(low, 4) <= e20 * 1.001
     and close > e20 and close > open and r >= 45 and r <= 68 and r > r[1]
shortSig = barstate.isconfirmed and tendShort and volOk and ta.highest(high, 4) >= e20 * 0.999
     and close < e20 and close < open and r >= 32 and r <= 55 and r < r[1]

stopL = math.max(math.min(ta.lowest(low, 5), close - 1.2 * a), close - 3 * a)
stopS = math.min(math.max(ta.highest(high, 5), close + 1.2 * a), close + 3 * a)

plot(e20, "EMA20", color.new(color.orange, 0))
bgcolor(tendLong ? color.new(color.green, 94) : tendShort ? color.new(color.red, 94) : na)

dibujar(bool esLong, float stop) =>
    R    = math.abs(close - stop)
    tp1  = esLong ? close + R : close - R
    tp2  = esLong ? close + 2 * R : close - 2 * R
    qty  = math.min(capital * riesgoPct / 100 / (R + close * 2 * comisionPct / 100), capital * maxLev / close)
    col  = esLong ? color.green : color.red
    txt  = (esLong ? "LONG" : "SHORT") + "\nEntrada " + str.tostring(close, format.mintick) +
         "\nStop " + str.tostring(stop, format.mintick) + "\nTP1 " + str.tostring(tp1, format.mintick) +
         "\nTP2 " + str.tostring(tp2, format.mintick) + "\nCantidad " + str.tostring(qty, "#.###")
    label.new(bar_index, esLong ? low : high, txt, color = col, textcolor = color.white,
         style = esLong ? label.style_label_up : label.style_label_down, size = size.small)
    line.new(bar_index, stop, bar_index + 16, stop, color = color.red, width = 2)
    line.new(bar_index, tp1, bar_index + 16, tp1, color = color.teal, style = line.style_dashed)
    line.new(bar_index, tp2, bar_index + 16, tp2, color = color.green, width = 2)

if longSig
    dibujar(true, stopL)
if shortSig
    dibujar(false, stopS)

alertcondition(longSig, "LONG", "LONG {{ticker}} @ {{close}} — corre: python -m agent_trading senal")
alertcondition(shortSig, "SHORT", "SHORT {{ticker}} @ {{close}} — corre: python -m agent_trading senal")
